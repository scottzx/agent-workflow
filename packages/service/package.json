{
  "name": "@1agents/acp-service",
  "version": "0.9.0",
  "description": "ACP runtime, CLI, HTTP/WebSocket service and DeepSeek Harness ACP/A2A plugins in one package.",
  "keywords": [
    "dreammate",
    "acp",
    "agent-runtime",
    "claude-code",
    "grok",
    "codex",
    "a2a"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottzx/1acp.git",
    "directory": "packages/service"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/src/package.js",
  "types": "./dist/src/package.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/package.d.ts",
      "import": "./dist/src/package.js"
    },
    "./package.json": "./package.json",
    "./roles": {
      "types": "./dist/src/roles/index.d.ts",
      "import": "./dist/src/roles/index.js"
    },
    "./runtime": {
      "types": "./vendor/runtime/dist/runtime.d.ts",
      "import": "./vendor/runtime/dist/runtime.js"
    },
    "./flows": {
      "types": "./vendor/runtime/dist/flows.d.ts",
      "import": "./vendor/runtime/dist/flows.js"
    },
    "./runtime-cli": "./vendor/runtime/dist/cli.js",
    "./agent-registry": {
      "types": "./vendor/runtime/dist/agent-registry.d.ts",
      "import": "./vendor/runtime/dist/agent-registry.js"
    },
    "./service": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./dsh": {
      "types": "./vendor/dsh/index.d.ts",
      "import": "./vendor/dsh/index.js"
    },
    "./dsh/preset": {
      "types": "./vendor/dsh/preset.d.ts",
      "import": "./vendor/dsh/preset.js"
    },
    "./dsh/imports": {
      "types": "./vendor/dsh/imports.d.ts",
      "import": "./vendor/dsh/imports.js"
    },
    "./client": "./vendor/dsh/client.js",
    "./cordis.patch.yml": "./vendor/dsh/cordis.patch.yml",
    "./a2a": {
      "types": "./dist/src/a2a/index.d.ts",
      "import": "./dist/src/a2a/index.js"
    }
  },
  "bin": {
    "acp-service": "dist/bin/acp-service.js"
  },
  "files": [
    "dist",
    "README.md",
    "skills",
    "vendor"
  ],
  "scripts": {
    "build": "node ../../scripts/embed-runtime.mjs && tsc -p tsconfig.build.json && node workbench-ui/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p workbench-ui/tsconfig.json",
    "test": "npm run build && npm run test:only",
    "prepack": "node ../../scripts/verify-package-build.mjs",
    "start": "tsx bin/acp-service.ts",
    "test:only": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@1agents/acp-runtime-sdk": "npm:@agentclientprotocol/sdk@^1.5.0",
    "@1agents/dreammate-network": "^0.5.0",
    "@1agents/dreammate-node": "^0.15.0",
    "@a2a-js/sdk": "1.3.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@openclaw/fs-safe": "^0.26.7",
    "commander": "^15.0.0",
    "dsh-zod": "npm:zod@4.4.3",
    "skillflag": "^0.2.1",
    "tsx": "^4.23.15",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@1agents/chat-view": "workspace:*",
    "@1agents/file-preview": "workspace:*",
    "@scottzx/1acp": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.14",
    "esbuild": "0.28.2",
    "preact": "10.29.2",
    "typescript": "^5.7.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./vendor/dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
