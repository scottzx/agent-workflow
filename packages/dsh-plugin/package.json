{
  "name": "@1agents/dsh-acp",
  "type": "module",
  "description": "agent-workflow DeepSeek Harness integration: external ACP Agent sessions for DeepSeek Harness.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./package.json": "./package.json",
    "./client": "./dist/client.js",
    "./imports": {
      "types": "./dist/imports.d.ts",
      "import": "./dist/imports.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-client.mjs",
    "test": "npm run build && npm run test:only",
    "test:only": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "ws": "^8.18.0",
    "@1agents/acp-service": "workspace:^",
    "dsh-zod": "npm:zod@4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "homepage": "https://scottzx.github.io/agent-workflow/",
  "bugs": {
    "url": "https://github.com/scottzx/agent-workflow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottzx/agent-workflow.git",
    "directory": "packages/dsh-plugin"
  },
  "license": "MIT",
  "private": true
}
