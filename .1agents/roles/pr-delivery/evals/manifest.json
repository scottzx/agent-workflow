          "anyTextPatterns": [
            "gitdir:",
            "伪造",
            "handwritten",
            "符号链接"
          ]
        },
        {
          "id": "l1-config-example-prefix",
          "description": "l1-gate 把 .1agents/config 前缀下的合法 *.example.json 也当成泄漏拒绝。",
          "anyFilePatterns": [
            ".1agents/roles/pr-delivery/checks/l1-gate.mjs"
          ],
          "anyTextPatterns": [
            ".1agents/config",
            "example.json",
            "误拒",
            "*.example.json"
          ]
        }
      ]
    },
    {
      "id": "pr14-pos-verified-worktree-fix",
      "pr": 14,
      "kind": "positive",
      "baseCommit": "e648d09b",
      "headCommit": "9bda36fe",
      "expectedVerdict": "PASS",
      "summary": "9bda36fe 拒绝伪造 .git 符号链接和手写 gitdir:，只有 gitdir 回指匹配的已注册 worktree 才算同一仓库。l1-gate 放行 .1agents/config 下的 *.example.json 与 *.example.yml。"
