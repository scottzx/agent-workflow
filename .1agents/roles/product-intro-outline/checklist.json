{
  "schemaVersion": 1,
  "roleId": "product-intro-outline",
  "outlineTemplate": {
    "locked": true,
    "sections": ["positioning", "features", "architecture", "getting_started", "screenshots"]
  },
  "items": [
    { "id": "P1", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "大纲 JSON 符合 checks/outline.schema.json" },
    { "id": "P2", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "字体是微软雅黑" },
    { "id": "P3", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "四档字号都是整数" },
    { "id": "P4", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "每页版式都在 style.layouts 里" },
    { "id": "P5", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "每个出处的文件在固定提交里存在、行号不超出文件长度，且不在用例排除的目录里" },
    { "id": "P6", "type": "program", "source": "task", "severity": "block", "locked": true,
      "rule": "确认过的每个功能 ID 至少出现在一条要点里，且没有清单外的 ID" },
    { "id": "P7", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "章节 ID 和 outlineTemplate 一致，不缺、不重复" },
    { "id": "A1", "type": "agent", "source": "task", "severity": "block", "locked": true,
      "rule": "每条要点的出处确实支持它的说法。只查有没有依据，不评价写得好不好",
      "evidence": "不通过的要点：页标题、要点原文、出处路径和行号、出处里实际写了什么" },
    { "id": "A2", "type": "agent", "source": "task", "severity": "block", "locked": true,
      "rule": "标为不适用的章节，原因属实：项目确实没有这一部分，或受众不是技术人员时省略技术架构",
      "evidence": "不通过的章节：章节 ID、给出的原因、仓库里与之矛盾的文件路径" },
    { "id": "P8", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "每页要点不超过 5 条" },
    { "id": "P9", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "受众能看到的文字里没有“待补”“TODO”这类占位" },
    { "id": "P10", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "同一条要点（去掉空白和标点后至少 12 个字）不在多页逐字重复" },
    { "id": "P11", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "发布文件名里写死的版本号，要和项目所有版本记录（package.json、RELEASE_NOTES.md、CHANGELOG.md 的首个标题）一致；记录本身不一致时不得写死版本号" },
    { "id": "P12", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "全稿最后一页用 closing 版式，且只有这一页用 closing" },
    { "id": "P13", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "页标题里数本页条目的写法（“四个动作”“三步”）和本页要点条数一致；序数（“第一步”“下一步”）和描述对象的数量（“六个演示场景”）不算" },
    { "id": "P14", "type": "program", "source": "norm", "severity": "block", "locked": true,
      "rule": "不同页的两条要点引用同一组出处文件时，不能有连续 8 个以上相同的汉字（换了说法的重复）；英文词、命令和链接不算" }
  ],
  "program": { "run": "checks/check_outline.py", "schema": "checks/outline.schema.json" }
}
